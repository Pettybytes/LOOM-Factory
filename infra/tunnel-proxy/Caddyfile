:8081 {
	# Discord Interactions Endpoint — PUBLIC (no tunnel token). Discord posts
	# here; Ed25519 signature verification happens in the local adapter.
	handle /discord/interactions* {
		reverse_proxy host.docker.internal:8090
	}

	# Editor endpoints (token exchange + completion) — PUBLIC. The browser /
	# Discord Activity calls these directly; each is protected by its own
	# single-use token + session validation in the adapter (not the tunnel token).
	handle /discord/editor/* {
		reverse_proxy host.docker.internal:8090
	}

	# Internal card-send endpoint — auth'd by the same tunnel token so only
	# the pipeline (n8n) can trigger a bot card.
	@card {
		path /discord/card*
		header Authorization "Bearer {$LOOM_TUNNEL_TOKEN}"
	}
	handle @card {
		reverse_proxy host.docker.internal:8090
	}

	# OpenShorts backend API — PUBLIC for the Activity editor's required /api/*
	# calls (status/edl/transcript/scenes/subtitle/rerender).
	# ⚠️ SECURITY NOTE: the OpenShorts backend has ZERO authentication (its
	# _assert_job_owner is a no-op when BILLING_ENABLED is unset). Making /api/*
	# public exposes it to the internet (bounded: job_ids are UUIDs, writes are
	# per-job). Revisit (add an editor-session gate) before production use.
	handle /api/* {
		reverse_proxy host.docker.internal:8000 {
			header_up X-Gemini-Key "{$LOOM_GEMINI_KEY}"
		}
	}

	# Dashboard frontend (Vite dev on host 5175) — PUBLIC. Serves the SPA; the
	# /edit route is handled client-side by the React app. The Host header is
	# rewritten to localhost so the Vite dev server (which blocks non-localhost
	# hosts) accepts the request; asset URLs are relative so the browser still
	# loads them from the public funnel origin.
	handle {
		reverse_proxy host.docker.internal:5175 {
			header_up Host localhost
		}
	}
}

:8082 {
	# LOOM callback relay (local-only, no public exposure of this port).
	# OpenShorts posts its terminal job.completed/job.failed webhook here.
	handle_path /relay* {
		rewrite * /webhook/loom-openshorts-callback
		reverse_proxy https://fns2.app.n8n.cloud {
			header_up Host fns2.app.n8n.cloud
			header_up X-LOOM-Relay-Token "{$LOOM_RELAY_TOKEN}"
		}
	}

	handle {
		respond "Not Found" 404
	}
}
