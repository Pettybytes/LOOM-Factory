+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import { getApiUrl } from '../config';
+import { apiFetch } from '../lib/api';
+
+// One-time launch-token exchange endpoint (the LOOM Discord adapter). The raw
+// launch token is consumed server-side on first use; only its hash was stored.
+const EDITOR_EXCHANGE_URL =
+  import.meta.env.VITE_EDITOR_EXCHANGE_URL || 'http://localhost:8090/discord/editor/exchange';
+
+function fmt(s) {
+  const n = Number(s);
+  if (!Number.isFinite(n)) return '—';
+  const m = Math.floor(n / 60);
+  const sec = (n % 60).toFixed(1).padStart(4, '0');
+  return `${m}:${sec}`;
+}
+
+function seekTo(videoRef, t) {
+  const v = videoRef.current;
+  if (!v) return;
+  try { v.currentTime = Math.max(0, Number(t)); } catch (_) { /* ignore */ }
+}
+
+export default function ManualTrimEditor() {
+  const [session, setSession] = useState(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState(null);
+
+  const [clipUrl, setClipUrl] = useState(null);
+  const [edl, setEdl] = useState(null);       // { segments, framing, canonical_range, source }
+  const [words, setWords] = useState([]);      // transcript word timeline
+  const [scenes, setScenes] = useState([]);
+  const [canonical, setCanonical] = useState({ start: 0, end: 0 });
+
+  const [trimStart, setTrimStart] = useState(0);
+  const [trimEnd, setTrimEnd] = useState(0);
+  const [instruction, setInstruction] = useState('');
+  const [rerendering, setRerendering] = useState(false);
+  const [result, setResult] = useState(null);
+
+  const videoRef = useRef(null);
+
+  // --- 1. One-time token exchange (consume immediately, strip URL) ----------
+  useEffect(() => {
+    const params = new URLSearchParams(window.location.search);
+    const jobId = params.get('job_id');
+    const clipIndex = params.get('clip_index');
+    const token = params.get('token');
+
+    // Strip the launch token from the URL immediately so it never lingers in
+    // history/referrer. Referrer-Policy: no-referrer is set globally in index.html.
+    // The raw token is sent ONLY in this single exchange body (never in logs).
+    if (window.location.search) history.replaceState({}, '', '/edit');
+
+    if (!jobId || clipIndex == null || !token) {
+      setError('Missing job_id, clip_index, or token.');
+      setLoading(false);
+      return;
+    }
+
+    let cancelled = false;
+    (async () => {
+      try {
+        const res = await fetch(EDITOR_EXCHANGE_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ token }),
+        });
+        const data = await res.json();
+        if (cancelled) return;
+        if (!data.ok) {
+          setError(data.error || 'Token exchange failed.');
+          setLoading(false);
+          return;
+        }
+        setSession({ ...data.session, job_id: jobId, clip_index: Number(clipIndex) });
+      } catch (e) {
+        if (!cancelled) {
+          setError('Token exchange error: ' + (e && e.message ? e.message : String(e)));
+          setLoading(false);
+        }
+      }
+    })();
+    return () => { cancelled = true; };
+  }, []);
+
+  // --- 2. Load clip metadata (EDL recipe + transcript + scenes + video) -----
+  useEffect(() => {
+    if (!session) return;
+    let cancelled = false;
+    (async () => {
+      try {
+        const { job_id, clip_index } = session;
+
+        // Video source for the preview.
+        const stRes = await apiFetch(`/api/status/${job_id}`);
+        const st = await stRes.json();
+        const clips = st?.result?.clips || st?.clips || [];
+        const cl = clips[clip_index] || clips[0];
+        const rawUrl = cl?.video_url || cl?.view_url || null;
+        if (rawUrl) setClipUrl(getApiUrl(rawUrl));
+
+        // Editable recipe (segments + canonical range + framing).
+        const edlRes = await apiFetch(`/api/clip/${job_id}/${clip_index}/edl`);
+        if (edlRes.ok) {
+          const e = await edlRes.json();
+          setEdl(e);
+          const cr = e.canonical_range || {};
+          const s = Number(cr.start ?? 0);
+          const en = Number(cr.end ?? e.source?.duration ?? 0);
+          setCanonical({ start: s, end: en });
+          setTrimStart(s);
+          setTrimEnd(en);
+        }
+
+        // Transcript (word timeline for seeking).
+        const tRes = await apiFetch(`/api/clip/${job_id}/${clip_index}/transcript`);
+        if (tRes.ok) {
+          const t = await tRes.json();
+          setWords(Array.isArray(t) ? t : (t?.words || t?.segments || []));
+        }
+
+        // Scenes (for seeking).
+        const scRes = await apiFetch(`/api/clip/${job_id}/${clip_index}/scenes`);
+        if (scRes.ok) setScenes(await scRes.json());
+      } catch (e) {
+        if (!cancelled) setError('Failed to load clip: ' + (e && e.message ? e.message : String(e)));
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    })();
+    return () => { cancelled = true; };
+  }, [session]);
+
+  // --- 3. Rerender (immutable: the edited output becomes a NEW asset version)
+  const handleRerender = useCallback(async () => {
+    if (!session || !edl) return;
+    setRerendering(true);
+    setResult(null);
+    setError(null);
+    try {
+      // A plain trim is a single segment inside the canonical range (FAST path).
+      const segments = [{ start: Number(trimStart), end: Number(trimEnd) }];
+      const res = await apiFetch('/api/clip/rerender', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          job_id: session.job_id,
+          clip_index: session.clip_index,
+          segments,
+          snap_to_words: true,
+          reapply_captions: true,
+          framing: (edl.framing === 'auto' ? 'auto' : undefined),
+          instruction: instruction.trim() || undefined,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setError('Rerender failed: ' + (data?.detail || data?.error || res.status));
+        setRerendering(false);
+        return;
+      }
+      setResult(data);
+    } catch (e) {
+      setError('Rerender error: ' + (e && e.message ? e.message : String(e)));
+    } finally {
+      setRerendering(false);
+    }
+  }, [session, edl, trimStart, trimEnd, instruction]);
+
+  if (loading) {
+    return (
+      <div className="min-h-screen flex items-center justify-center bg-paper text-ink2">
+        <p className="text-sm text-muted">Opening editor session…</p>
+      </div>
+    );
+  }
+
+  if (error && !session) {
+    return (
+      <div className="min-h-screen flex items-center justify-center bg-paper text-ink2 p-6">
+        <div className="max-w-md text-center space-y-3">
+          <h1 className="font-display lowercase text-2xl text-ink">editor unavailable</h1>
+          <p className="text-sm text-muted">{error}</p>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="min-h-screen bg-paper text-ink2">
+      <header className="h-14 border-b border-rule flex items-center justify-between px-4 sm:px-6">
+        <span className="font-display lowercase text-lg text-ink">LOOM editor</span>
+        <span className="text-xs text-muted">
+          {session?.tenant_id} · {session?.clip_id} · {session?.source_asset_version}
+        </span>
+      </header>
+
+      <main className="p-4 sm:p-6 max-w-5xl mx-auto space-y-6">
+        {error && <div className="text-sm text-red-400 bg-red-400/10 border border-red-400/20 rounded-lg p-3">{error}</div>}
+
+        {/* Video preview */}
+        <div className="grid md:grid-cols-2 gap-6">
+          <div className="space-y-3">
+            <video
+              ref={videoRef}
+              src={clipUrl}
+              controls
+              className="w-full rounded-lg bg-black aspect-[9/16] object-contain"
+            />
+            {clipUrl == null && <p className="text-xs text-muted">(preview unavailable — no clip URL)</p>}
+          </div>
+
+          {/* Trim controls */}
+          <div className="space-y-4">
+            <h2 className="font-display lowercase text-xl text-ink">trim</h2>
+            <div className="grid grid-cols-2 gap-3">
+              <label className="text-xs text-muted">
+                start (s)
+                <input
+                  type="number" step="0.1" min={canonical.start} max={canonical.end}
+                  value={trimStart}
+                  onChange={(e) => { setTrimStart(e.target.value); seekTo(videoRef, e.target.value); }}
+                  className="mt-1 w-full bg-background border border-rule rounded-lg px-3 py-2 text-ink"
+                />
+              </label>
+              <label className="text-xs text-muted">
+                end (s)
+                <input
+                  type="number" step="0.1" min={canonical.start} max={canonical.end}
+                  value={trimEnd}
+                  onChange={(e) => { setTrimEnd(e.target.value); seekTo(videoRef, e.target.value); }}
+                  className="mt-1 w-full bg-background border border-rule rounded-lg px-3 py-2 text-ink"
+                />
+              </label>
+            </div>
+            <div className="text-sm text-ink">
+              duration <span className="text-brass">{fmt(trimEnd - trimStart)}</span>
+              <span className="text-muted"> · source range {fmt(canonical.start)}–{fmt(canonical.end)}</span>
+            </div>
+
+            {/* Optional written instruction (LLM assist only when non-empty) */}
+            <label className="block text-xs text-muted">
+              written instruction (optional — no Gemini when empty)
+              <textarea
+                value={instruction}
+                onChange={(e) => setInstruction(e.target.value)}
+                rows={3}
+                placeholder="e.g. tighten the opening, cut the pause at the start"
+                className="mt-1 w-full bg-background border border-rule rounded-lg px-3 py-2 text-ink resize-y"
+              />
+            </label>
+
+            <button
+              onClick={handleRerender}
+              disabled={rerendering || !edl}
+              className="btn-primary px-4 py-2 w-full disabled:opacity-50"
+            >
+              {rerendering ? 'rerendering…' : 'rerender (new asset version)'}
+            </button>
+
+            {result && (
+              <div className="text-sm text-ink bg-background border border-rule rounded-lg p-3">
+                ✓ rerender accepted — new asset version pending re-review
+              </div>
+            )}
+          </div>
+        </div>
+
+        {/* Transcript + scenes seeking */}
+        <div className="grid md:grid-cols-2 gap-6">
+          <div className="space-y-2">
+            <h3 className="font-display lowercase text-lg text-ink">transcript</h3>
+            <div className="max-h-64 overflow-y-auto space-y-1">
+              {(words || []).slice(0, 200).map((w, i) => {
+                const t = w?.start ?? w?.s ?? w?.t ?? 0;
+                const txt = w?.word ?? w?.text ?? w?.w ?? '';
+                return (
+                  <button key={i} onClick={() => seekTo(videoRef, t)}
+                    className="block text-left text-xs text-muted hover:text-ink w-full px-2 py-1 rounded hover:bg-background">
+                    <span className="text-brass tabular-nums">{fmt(t)}</span> {txt}
+                  </button>
+                );
+              })}
+              {words.length === 0 && <p className="text-xs text-muted">(no transcript)</p>}
+            </div>
+          </div>
+
+          <div className="space-y-2">
+            <h3 className="font-display lowercase text-lg text-ink">scenes</h3>
+            <div className="max-h-64 overflow-y-auto space-y-1">
+              {(scenes || []).map((s, i) => {
+                const t = s?.start ?? s?.t ?? 0;
+                const label = s?.label ?? s?.scene ?? `scene ${i + 1}`;
+                return (
+                  <button key={i} onClick={() => seekTo(videoRef, t)}
+                    className="block text-left text-xs text-muted hover:text-ink w-full px-2 py-1 rounded hover:bg-background">
+                    <span className="text-brass tabular-nums">{fmt(t)}</span> {label}
+                  </button>
+                );
+              })}
+              {scenes.length === 0 && <p className="text-xs text-muted">(no scenes)</p>}
+            </div>
+          </div>
+        </div>
+      </main>
+    </div>
+  );
+}
