    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.lockedJobs = staticData.lockedJobs || {};\nconst body = $json.body || {};\nconst jobId = body.job_id || 'unknown';\nconst isResume = body.resume === true;\n\nif (staticData.lockedJobs[jobId] && !isResume) {\n  const locked = staticData.lockedJobs[jobId];\n  throw new Error('DUPLICATE_CALLBACK_IGNORED: job_id ' + jobId + ' already locked by event \"' + locked.event + '\" at ' + locked.processedAt + ' -- rejecting later event \"' + (body.event || 'unknown') + '\"');\n}\n\nif (isResume) {\n  delete staticData.lockedJobs[jobId];\n}\n\nstaticData.lockedJobs[jobId] = { event: body.event || 'unknown', processedAt: new Date().toISOString(), resume: isResume };\nreturn [{ json: $json }];"
      },
      "id": "deduplicate-callback",
      "name": "Deduplicate Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $json.body;\nif (!body || !body.event || !['job.completed', 'job.failed'].includes(body.event)) {\n  throw new Error('MALFORMED_STATUS_RESPONSE: callback missing or invalid event field: ' + JSON.stringify(body && body.event));\n}\nif (!body.job_id) {\n  throw new Error('MALFORMED_STATUS_RESPONSE: callback missing job_id');\n}\nreturn [{ json: $json }];\n"
      },
      "id": "validate-terminal-event",
      "name": "Validate Terminal Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst body = $json.body;\nconst jobId = body.job_id;\nconst pending = (staticData.pendingRuns || {})[jobId];\nif (!pending) {\n  throw new Error('CANDIDATE_NORMALIZATION_FAILED: no pending run context found for job_id ' + jobId + ' (submitted via a different execution, static data not persisted, or already consumed)');\n}\nreturn [{ json: {\n  run_id: pending.run_id,\n  tenant_id: pending.tenant_id,\n  job_id: jobId,\n  source_url: pending.source_url,\n  started_at: pending.submitted_at,\n  event: body.event,\n  error: body.error || null,\n  cached_scores: body.cached_scores || {}\n} }];"
      },
