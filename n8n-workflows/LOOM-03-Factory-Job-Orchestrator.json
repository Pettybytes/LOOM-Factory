              "name": "auto_hook_style",
              "value": "classic"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "5FDwahQgAPWe53MD",
          "name": "LOOM Tunnel Proxy Token"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "check-submit",
      "name": "Check Submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "jsCode": "if ($json.error) {\n  return [{ json: { ...$('Create Run Context').item.json, failure_code: 'OPENSHORTS_SUBMISSION_UNKNOWN', error_message: $json.error.message } }];\n}\nif (!$json.job_id) {\n  return [{ json: { ...$('Create Run Context').item.json, failure_code: 'OPENSHORTS_SUBMISSION_FAILED', error_message: 'No job_id returned' } }];\n}\nreturn [{ json: { ...$('Create Run Context').item.json, job_id: $json.job_id } }];"
      }
    },
    {
      "id": "validate-completed-1",
      "name": "Validate Completed Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "const context = $('Correlate Run Context').item.json;\nconst p = $json;\n\nif (!p.result || !Array.isArray(p.result.clips) || p.result.clips.length === 0) {\n  throw new Error('NO_CLIPS_RETURNED: Completed job returned zero clips');\n}\n\nconst uniqueClips = [];\nconst seenKeys = new Set();\np.result.clips.forEach((clip, index) => {\n  const candidateKey = context.job_id + ':' + index;\n  if (!seenKeys.has(candidateKey)) {\n    seenKeys.add(candidateKey);\n    uniqueClips.push(clip);\n  }\n});\n\nreturn [{ json: {\n  run_id: context.run_id,\n  tenant_id: context.tenant_id,\n  job_id: context.job_id,\n  source_url: context.source_url,\n  started_at: context.started_at,\n  cached_scores: context.cached_scores || {},\n  status_response: { result: { clips: uniqueClips } }\n} }];"
      }
    },
    {
      "id": "split-clips",
      "name": "Split Completed Clips",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "jsCode": "const clips = ($json.status_response && $json.status_response.result && $json.status_response.result.clips) || [];\nconst cachedScores = $json.cached_scores || {};\nreturn clips.map((clip, index) => ({ json: { ...clip, _clip_index: index, _cached_score: cachedScores[$json.job_id + ':' + index] || null } }));"
      }
    },
    {
      "id": "attach-context",
      "name": "Attach Job and Tenant Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        300
      ],
      "parameters": {
        "jsCode": "const context = $('Validate Completed Job').item.json;\nreturn $input.all().map(item => {\n  const clip = item.json;\n  const noSpeech = clip.no_speech === true;\n  return { json: {\n    run_id: context.run_id,\n    tenant_id: context.tenant_id,\n    job_id: context.job_id,\n    clip_index: clip._clip_index,\n    source_url: context.source_url,\n    clip_start: clip.start,\n    clip_end: clip.end,\n    clip_hook: clip.viral_hook_text || clip.hook_text || null,\n    clip_score: clip.predicted_score || null,\n    asset_url: clip.video_url || null,\n    // Candidate-specific Shorts title (proposed), distinct from source title.\n    clip_title: clip.video_title_for_youtube_short || clip.title || null,\n    master_asset: clip.master_asset || null,\n    ready_file: clip.ready_file || null,\n    captions_applied: clip.captions_applied === true,\n    hook_applied: clip.hook_applied === true,\n    no_speech: noSpeech,\n    transcript_segment_count: clip.transcript_segment_count || 0,\n    render_version: clip.render_version || null,\n    captions_expected: !noSpeech,\n    hook_expected: true,\n    source_context: null,\n    platform_targets: ['tiktok', 'instagram_reels', 'youtube_shorts', 'facebook_reels'],\n    streamer_profile: null\n  } };\n});"
      }
    },
    {
      "id": "exec-wf02",
      "name": "Execute Workflow 02",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "onError": "continueErrorOutput",
      "position": [
        2800,
        300
      ],
      "parameters": {
        "workflowId": "6RNa6TXeppCQ7bhh",
        "mode": "each"
      }
    },
    {
      "id": "capture-result",
      "name": "Capture Success/Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: item.json }));"
      }
    },
    {
      "id": "aggregate",
      "name": "Aggregate Batch Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3200,
        300
      ],
      "parameters": {
        "jsCode": "const items = $items('Capture Success/Error');\nconst context = $('Validate Completed Job').item.json;\nlet scored = [];\nlet failed = [];\nlet summary = { publishable: 0, repairable: 0, reject: 0, failed: 0 };\n\nitems.forEach(item => {\n  const result = item.json.scored_candidate || item.json;\n  if (result.error) {\n    failed.push({ error: (result.error && result.error.message) ? result.error.message : String(result.error) });\n    summary.failed++;\n  } else {\n    scored.push(result);\n    if (result.decision === 'publishable') summary.publishable++;\n    else if (result.decision === 'repairable') summary.repairable++;\n    else summary.reject++;\n  }\n});\n\nconst total = items.length;\nconst status = (scored.length > 0 && failed.length > 0) ? 'partial' : (scored.length > 0 ? 'completed' : 'failed');\n\nreturn [{ json: {\n  schema_version: \"1.0\",\n  run_id: context.run_id,\n  tenant_id: context.tenant_id,\n  job_id: context.job_id,\n  source_type: \"youtube_vod\",\n  source_url: context.source_url,\n  status: status,\n  started_at: context.started_at,\n  completed_at: new Date().toISOString(),\n  poll_count: context.poll_count,\n  total_candidates: total,\n  scored_candidates: scored,\n  failed_candidates: failed,\n  summary: summary\n} }];"
      }
    },
    {
      "id": "exec-wf00",
      "name": "Factory Failure Handler",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        2200,
        500
      ],
      "parameters": {
        "workflowId": "IYB1Pp8cTMrghaoK"
      }
