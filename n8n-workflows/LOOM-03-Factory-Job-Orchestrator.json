    {
      "parameters": {
        "jsCode": "\nconst p = $json;\nreturn [{ json: {\n  schema_version: '1.0',\n  failure_id: require('crypto').randomUUID(),\n  occurred_at: new Date().toISOString(),\n  run_id: p.run_id,\n  execution_id: $execution.id,\n  workflow_id: $workflow.id,\n  tenant_id: p.tenant_id,\n  source_type: 'youtube_vod',\n  source_url: p.source_url,\n  job_id: p.job_id || null,\n  clip_id: null,\n  stage: 'submission',\n  failure_code: p.failure_code,\n  retryable: false,\n  attempt: 1,\n  max_attempts: 1,\n  http_status: null,\n  error_message: (p.error_message || 'Submission failed').toString().substring(0, 1000),\n  evidence: {}\n} }];\n"
      },
