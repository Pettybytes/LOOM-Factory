    {
      "parameters": {
        "jsCode": "\n// Persist Run Context: the OpenShorts terminal callback payload contains\n// only job_id (no run_id/tenant_id/source_url). This durable map lets the\n// callback correlate back to the originating run. n8n workflow static data\n// only persists for PRODUCTION executions (documented n8n behavior, also\n// noted in the installed OpenShorts n8n example README) -- this workflow\n// must be active for this correlation to survive between submit and callback.\nconst staticData = $getWorkflowStaticData('global');\nstaticData.pendingRuns = staticData.pendingRuns || {};\nconst ctx = $json; // from Check Submission\nstaticData.pendingRuns[ctx.job_id] = {\n  run_id: ctx.run_id,\n  tenant_id: ctx.tenant_id,\n  source_url: ctx.source_url,\n  submitted_at: ctx.started_at\n};\n\nreturn [{ json: {\n  run_id: ctx.run_id,\n  job_id: ctx.job_id,\n  tenant_id: ctx.tenant_id,\n  source_url: ctx.source_url,\n  status: 'submitted_awaiting_callback',\n  webhook_registered: true\n} }];\n"
      },
      "id": "persist-run-context",
      "name": "Persist Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "abc-1",
                    "leftValue": "={{ $json.failure_code ? 'fail' : 'ok' }}",
                    "rightValue": "ok",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ok"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "abc-2",
                    "leftValue": "={{ $json.failure_code ? 'fail' : 'ok' }}",
                    "rightValue": "fail",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "fail"
            }
          ]
        },
        "options": {
          "fallbackOutput": 1
        }
      },
