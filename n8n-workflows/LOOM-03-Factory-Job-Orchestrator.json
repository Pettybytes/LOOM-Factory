      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "source_url",
              "value": "https://www.youtube.com/watch?v=xtOKTsIYwH0",
              "type": "string"
            },
            {
              "id": "2",
              "name": "tenant_id",
              "value": "loom-internal-test",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "validate-source-1",
      "name": "Validate Source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "jsCode": "const input = $json;\nconst urlStr = input.source_url;\ntry {\n  if (typeof urlStr !== 'string' || !urlStr) throw new Error('URL is empty or not a string');\n  const m = urlStr.match(/^([a-zA-Z][a-zA-Z0-9+.-]*):\\/\\/([^\\/?#]+)/);\n  if (!m) throw new Error('Malformed URL');\n  const protocol = m[1].toLowerCase() + ':';\n  const hostname = m[2].split('@').pop().split(':')[0].toLowerCase();\n  const allowlist = ['youtube.com', 'www.youtube.com', 'youtu.be', 'twitch.tv', 'www.twitch.tv', 'kick.com', 'www.kick.com'];\n  if (protocol !== 'https:') throw new Error('Must be HTTPS');\n  if (!allowlist.includes(hostname)) throw new Error('Domain not in allowlist');\n  if (urlStr.includes('list=')) throw new Error('Playlist/Mix URLs rejected by MVP policy');\n} catch (e) {\n  throw new Error('SOURCE_VALIDATION_FAILED: ' + e.message);\n}\nreturn [{ json: input }];"
      }
    },
    {
      "id": "create-run-1",
      "name": "Create Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nreturn [{ json: { ...$json, run_id: 'loom-run-' + crypto.randomUUID(), started_at: new Date().toISOString(), poll_count: 0 } }];"
      }
    },
    {
      "id": "submit-1",
      "name": "Submit OpenShorts Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [
        800,
        300
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "https://app.loomz.stream/pipeline/api/process",
        "method": "POST",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.source_url }}"
            },
            {
              "name": "webhook_url",
              "value": "http://host.docker.internal:8082/relay"
            },
            {
              "name": "acknowledged",
              "value": "true"
            },
            {
              "name": "output_format",
              "value": "vertical"
            },
            {
              "name": "auto_hook",
